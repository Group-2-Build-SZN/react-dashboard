# Base URL for the My Ulo API (see /mnt Swagger doc / azurewebsites deployment)
VITE_API_BASE_URL=https://myulo-api-fkg9hadcdpc8excc.southafricanorth-01.azurewebsites.net/api/v1

# Google OAuth 2.0 Web Client ID, used for "Continue with Google" (Login/Signup).
# Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application -> add this site's origin(s) under
# "Authorized JavaScript origins"). Leave unset and the button will render
# disabled instead of breaking.
VITE_GOOGLE_CLIENT_ID=
